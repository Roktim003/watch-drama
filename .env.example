# Copy this file to .env.local and set a real admin password.
# Used to log in at /admin. If ADMIN_PASSWORD is not set at all, the
# development default "admin123" is used and the admin panel shows a
# warning banner — never deploy like that.
ADMIN_PASSWORD=

# Optional (Phase 3): secret used to sign viewer session cookies
# (wd_user). If unset, ADMIN_PASSWORD is used; if that's unset too, a
# development constant is used. Set a long random value before deploying.
USER_SESSION_SECRET=change-me-to-a-strong-password
