# ─────────────────────────────────────────────────────────────────────────────
# WatchDrama — environment configuration.
#
# Local dev:  copy to `.env.local`   (cp .env.example .env.local)
# Production: copy to `.env`         (docker compose reads `.env`)
#
# ★ = REQUIRED before go-live. Everything else has a safe default.
# ─────────────────────────────────────────────────────────────────────────────

# ★ REQUIRED — password for the /admin panel.
# If this is not set, the development default "admin123" is used, the
# admin panel shows a warning banner, and the production server logs a
# loud SECURITY WARNING at startup. Use a long, unique password.
ADMIN_PASSWORD=

# ★ REQUIRED — secret used to sign viewer session cookies (wd_user).
# Use a long random string (e.g. `openssl rand -hex 32`). If unset,
# ADMIN_PASSWORD is used; if that's unset too, a development constant
# is used — fine for local dev, not for a live site. Changing it logs
# out every viewer.
USER_SESSION_SECRET=

# ★ REQUIRED for correct SEO/social links — your site's public URL,
# no trailing slash. It is used for Open Graph tags, robots.txt and
# sitemap.xml, and is baked into page metadata at build time, so set it
# BEFORE building (docker compose passes it as a build argument).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where catalog.json + users.json live (Phase 4).
# Leave UNSET for local dev (files go in ./data). docker-compose sets
# this to /app/data-persist (a Docker volume) automatically — you do
# not need to set it in .env for the Docker route.
# DATA_DIR=/app/data-persist

# Port the production server listens on. Default 3000.
# docker-compose maps 3000:3000; change the compose mapping if you
# change this.
# PORT=3000
