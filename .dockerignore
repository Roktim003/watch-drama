# Dependencies & build output (rebuilt inside the image)
node_modules
.next
out

# Local env files — secrets come from the host's .env via compose.
# (.env.example is documentation and stays.)
.env
.env.*
!.env.example
.env.local

# VCS, editor, OS noise
.git
.gitignore
.vscode
.idea
.DS_Store

# Project packages / docs not needed at runtime
*.zip
*.log
npm-debug.log*
coverage
